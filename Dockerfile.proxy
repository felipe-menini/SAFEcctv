FROM caddy:2.11.7-alpine
# Port 8443 needs no file capabilities; retaining official file-cap breaks cap_drop ALL.
RUN setcap -r /usr/bin/caddy
# Named volumes inherit these owners on first creation; no root init container.
RUN mkdir -p /data/caddy /config/caddy && chown -R 10001:10001 /data /config && chmod 700 /data /config
COPY Caddyfile.lan /etc/caddy/Caddyfile
USER 10001:10001
EXPOSE 8443

COMPOSE_PROJECT_NAME=safe-manager
# SOLO bootstrap inicial. El servidor no modifica usuarios existentes al recrear.
SAFE_ADMIN_PASSWORD=
SAFE_CCTV_PASSWORD=
# Bind local por defecto. Para LAN privada: IP del servidor o 0.0.0.0 + firewall.
SAFE_BIND_HOST=127.0.0.1
SAFE_PUBLIC_PORT=8787
# 1 solamente detr?s de HTTPS (obligatorio para exposici?n fuera de LAN/VPN).
SAFE_SECURE_COOKIE=0
